				{
					"listen": "test",
					"script": {
						"exec": [
							"// Assert that the response status is 200\r",
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Extract the 'enrollment token' from the response\r",
							"var enrollmentUrl = JSON.parse(responseBody).enrollmentUrl;\r",
							"var token = enrollmentUrl.split(\"=\");\r",
							"pm.environment.set(\"enrollmentToken\",token[1]);\r",
							"\r",
							"\r",
